// Cloudflare Pages: serves the static export in ./out (next.config.ts sets output: "export").
// Pages project settings: build command `npm run build`, build output directory `out`,
// environment variables NODE_VERSION=22 and NEXT_PUBLIC_SITE_URL=https://<project>.pages.dev.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kepammeter",
  "compatibility_date": "2026-09-03",
  "pages_build_output_dir": "./out"
}
